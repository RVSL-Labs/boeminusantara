# Backend sub-server (boemi-api). Dev: http://localhost:4700 · Prod: /api (di-proxy nginx)
BOEMI_API_URL=http://localhost:4700

# Supabase (Auth Email/Google di FE). Data katalog kini via boemi-api, bukan langsung.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role (server-only, untuk admin panel & seed) — JANGAN diekspos ke client
SUPABASE_SERVICE_ROLE_KEY=

# Allowlist email admin (comma) — WAJIB diisi di produksi untuk pagar /admin.
# Kosong = semua user login bisa akses /admin (mode dev sederhana).
ADMIN_EMAILS=

# Payment gateway (fase checkout) — pilih salah satu untuk V1
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# XENDIT_SECRET_KEY=

# Content generator (fitur nanti)
# MAGIN_API_URL=
# MAGIN_API_KEY=

# PPN (11 atau 12) — configurable, konfirmasi akunting client
NEXT_PUBLIC_PPN_RATE=11
